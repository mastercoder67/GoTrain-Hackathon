# These are shell environment settings, not automatically loaded from this file.
# No API keys: the SageMaker execution role supplies Bedrock and optional S3 access.
GOTRAIN_DATA=/home/sagemaker-user/gotrain-data
GOTRAIN_RUNS=/home/sagemaker-user/gotrain-runs/v1
GOTRAIN_ARTIFACTS=/home/sagemaker-user/gotrain-artifacts
AWS_REGION=eu-central-1
GOTRAIN_BEDROCK_MODEL=eu.anthropic.claude-sonnet-5-5
# GOTRAIN_S3_BUCKET=organizer-provided-bucket
